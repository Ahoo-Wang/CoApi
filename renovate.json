{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Shanghai",
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "commitMessageTopic": "{{depName}}",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": false
  },
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group Spring ecosystem updates into a single PR",
      "groupName": "spring",
      "matchPackageNames": [
        "/^org\\.springframework/"
      ]
    },
    {
      "description": "Group Kotlin-related updates into a single PR",
      "groupName": "kotlin",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin/"
      ]
    },
    {
      "description": "esbuild >=0.26 errors on vite 6 legacy build targets (see #265); stay on 0.25.x until VitePress 2 / vite 7",
      "matchFileNames": [
        "wiki/**"
      ],
      "matchPackageNames": [
        "esbuild"
      ],
      "allowedVersions": "^0.25"
    }
  ]
}
